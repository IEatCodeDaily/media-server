# PUID and PGID are used to set the owner of the files and directories created by the container
# Particularly useful when mounting a NAS (NFS/SMB) to the container.
PUID=1000
PGID=100
TZ=Asia/Jakarta

# Local storage configuration (used with storage-local profile)
LOCAL_MEDIA_DIRECTORY=/media/Media

# SMB storage configuration (used with storage-smb profile)
SMB_USER=username
SMB_PASSWORD=password
SMB_SERVER=server-address
SMB_SHARE=Media

# Directory for configuration files
CONFIG_DIRECTORY=/opt/docker/media-server

# Domain name for the media server. will be used for reverse proxy, e.g.: jellyfin.media.home
DOMAIN_NAME=media.home

# Comma separated list of profiles to be enabled. 
# IMPORTANT: Always include EITHER storage-local OR storage-smb (not both)
# 
# Core services (always needed):
# - core (traefik, watchtower)
#
# Dashboard services:
# - organizr
# - homarr
#
# Media services:
# - jellyfin (includes jellyseerr)
# - plex (includes overseerr)
#
# Download clients:
# - qbittorrent
# - transmission
#
# Media management:
# - sonarr
# - radarr
# - lidarr
# - readarr
# - bazarr
# - prowlarr
# - recyclarr
#
# Network:
# - gluetun
# - flaresolverr
#
# Other:
# - portainer
#
# Storage type (choose ONE):
# - storage-local
# - storage-smb
#
# Example for SMB storage: 
# COMPOSE_PROFILES=core,jellyfin,organizr,portainer,qbittorrent,flaresolverr,storage-smb
#
# Example for local storage:
# COMPOSE_PROFILES=core,jellyfin,organizr,portainer,qbittorrent,flaresolverr,storage-local
COMPOSE_PROFILES=core,jellyfin,organizr,portainer,qbittorrent,flaresolverr,storage-local

# VPN profile - used with gluetun
VPN_SERVICE=vpn_service
VPN_USER=vpn_user
VPN_PASSWORD=vpn_password
